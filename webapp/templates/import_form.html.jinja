<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Court IQ — Import Match</title>
  <style>
    body { font-family: sans-serif; max-width: 640px; margin: 2rem auto; }
    label { display: block; margin-top: 0.75rem; }
    input, select, textarea { width: 100%; box-sizing: border-box; padding: 0.35rem; }
    .error { color: #b3261e; }
    .row { display: flex; gap: 1rem; }
    .row > div { flex: 1; }
    button { margin-top: 1.5rem; padding: 0.6rem 1.2rem; }
  </style>
</head>
<body>
  <h1>Import a SwingVision match</h1>
  {% if error %}<p class="error">{{ error }}</p>{% endif %}
  <form method="post" action="/import" enctype="multipart/form-data">
    <label>SwingVision export (.xlsx)
      <input type="file" name="xlsx_file" accept=".xlsx" required>
    </label>
    <label>Match video (optional, multiple files allowed for a split recording)
      <input type="file" name="video_files" multiple>
    </label>

    <div class="row">
      <div>
        <label>Date
          <input type="date" name="date" required>
        </label>
      </div>
      <div>
        <label>Opponent
          <input type="text" name="opponent" required>
        </label>
      </div>
      <div>
        <label>Result
          <select name="result" required>
            <option value="W">Win</option>
            <option value="L">Loss</option>
          </select>
        </label>
      </div>
    </div>

    <label>Confirm your name as tracked by SwingVision (optional)
      <input type="text" name="tracked_identity" placeholder="e.g. Rishi Gupta">
    </label>

    <div class="row">
      {% for n in (1, 2, 3) %}
      <div>
        <label>Who served first in Set {{ n }}? (optional)
          <select name="first_server_set{{ n }}">
            <option value="">Not sure / N/A</option>
            <option value="me">Me</option>
            <option value="opponent">Opponent</option>
          </select>
        </label>
      </div>
      {% endfor %}
    </div>

    <div class="row">
      <div>
        <label>Energy rating (1-5)
          <input type="number" name="energy_rating" min="1" max="5">
        </label>
      </div>
      <div>
        <label>Mental rating (1-5)
          <input type="number" name="mental_rating" min="1" max="5">
        </label>
      </div>
      <div>
        <label>Location
          <input type="text" name="location">
        </label>
      </div>
    </div>

    <label>Pros
      <textarea name="pros" rows="2"></textarea>
    </label>
    <label>Cons
      <textarea name="cons" rows="2"></textarea>
    </label>
    <label>Notes
      <textarea name="notes" rows="2"></textarea>
    </label>

    <button type="submit">Import</button>
  </form>
</body>
</html>
