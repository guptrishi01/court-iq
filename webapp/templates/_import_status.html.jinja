{% if error %}
<p class="error">{{ error }}</p>
{% else %}
<h2>Staged: {{ date }} vs {{ opponent }}</h2>
<p>Pending file: <code>{{ json_filename }}</code></p>
<p class="flags">{{ flag_count }} point(s) still need review before this match can be finalized.</p>

<h3>Data-quality notes</h3>
{% if import_notes %}
<ul>
  {% for note in import_notes %}
  <li>{{ note }}</li>
  {% endfor %}
</ul>
{% else %}
<p>No data-quality notes.</p>
{% endif %}

{% if not suggested %}
<form id="suggest-form" method="post" action="/suggest">
  <input type="hidden" name="json_filename" value="{{ json_filename }}">
  <button type="submit">Run Claude suggestions now (spends real API money)</button>
</form>
{% else %}
<p>Claude suggestions have been added to the pending file.</p>
{% endif %}
{% endif %}
